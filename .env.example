# 「提线」(Marionette) 环境变量样例
# 用法：cp .env.example .env 然后逐项填写。.env 已被 .gitignore 忽略，切勿提交。
# 所有密钥只从环境变量读取，不入库、不进 git（SPEC §10 安全约束）。

# ============ 域名与 HTTPS ============
# 有域名（生产）：填真实域名，例如 play.example.com；Caddy 自动申请 HTTPS 证书。
# 无域名（仅本地调试）：填 :80，走纯 HTTP。
DOMAIN=:80

# ============ 访问控制（AC-02 / AC-03，合规前置条件，必填）============
# 单用户访问口令。登录后签发 HttpOnly 签名会话令牌下发到浏览器。
# 建议：12 位以上随机串。留空或保持默认值时服务仍会启动，但会打印醒目告警。
ACCESS_PASSWORD=change-me-now
# 会话令牌签名密钥。务必替换为随机串（例：openssl rand -hex 32）。泄露等于会话可被伪造。
SECRET_KEY=dev-insecure-secret-change-me
# 令牌 Cookie 是否仅经 HTTPS 传输。走 :80 纯 HTTP 调试时必须设为 false，否则浏览器不回传 Cookie。
SESSION_COOKIE_SECURE=true
# 连续错误口令达到该次数后触发限流（默认 5 次）。
ACCESS_MAX_FAILED=5
# 限流锁定时长（秒），默认 900 秒（15 分钟）。
ACCESS_LOCK_WINDOW_SECONDS=900

# ============ 数据库 ============
DB_USER=postgres
DB_PASSWORD=marionette_dev_password
DB_NAME=marionette

# ============ LLM 后端（BYOK，自研 OpenAI 兼容薄层）============
# provider 取值：ollama | openai_compatible | zhipu | dashscope | deepseek
LLM_PROVIDER=openai_compatible
# 兼容 OpenAI 协议的 base_url，需带 /v1。例如 https://api.deepseek.com/v1
LLM_BASE_URL=
# 你的 API Key（写入后仅存环境变量，不落库）
LLM_API_KEY=
# 模型名，例如 deepseek-chat / qwen-plus
LLM_MODEL=

# ============ 图像生成后端（BYOK，云端图像 API）============
# provider 取值：cloud（OpenAI 兼容 images 接口）| local_comfyui（v1 默认关闭）
IMAGE_PROVIDER=cloud
# 兼容 OpenAI images 接口的 base_url，需带 /v1
IMAGE_BASE_URL=
IMAGE_API_KEY=
# 图像模型名，例如 dall-e-3 / flux-schnell
IMAGE_MODEL=

# ============ 前端跨域（前后端分离开发时填写）============
# 逗号分隔；留空时默认放行 Vite 开发服务器 http://localhost:5173
# 例如：CORS_ORIGINS=https://play.example.com
CORS_ORIGINS=

# ============ 其他 ============
APP_ENV=production
TZ=Asia/Shanghai
