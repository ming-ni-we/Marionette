# 统一换行符：Shell 脚本与容器相关文件必须保持 LF，否则在 Linux 容器内会报
# "/bin/sh^M: bad interpreter" 之类错误（Windows 检出时 git 默认会转成 CRLF）。
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Caddyfile       text eol=lf
entrypoint.sh   text eol=lf

# Python / 前端源码统一 LF
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.css           text eol=lf

# Windows 批处理保持 CRLF
*.bat           text eol=crlf

# 二进制资产不做换行转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.ico           binary
*.woff          binary
*.woff2         binary
